#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>


#define AS(keycode) &as LS(keycode) keycode

/ {
    chosen {
      zmk,matrix_transform = &five_column_transform;
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };
        
        ctrl {
            bindings = <&kp LCTRL>;
            key-positions = <20 21>;
        };

        ctrlleft {
            bindings = <&kp LCTRL>;
            key-positions = <28 29>;
        };

        linux_or_mac {
            bindings = <&tog 4>;
            key-positions = <0 4>;
        };

        modnumber {
            bindings = <&mo 1>;
            key-positions = <12 13>;
            layers = <0>;
        };

        mod_number_linux {
            bindings = <&mo 5>;
            key-positions = <12 13>;
            layers = <4>;
        };
    };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// ---------------------------------------------------------------------
// |  A  |  Z  |  E  |  R  |  T  |     |  Y  |  U   |  I   |   O   | P |
// |  Q  |  S  |  D  |  F  |  G  |     |  H  |  J   |  K   |   L   | M | 
// |  W  |  X  |  C  |  V  |  B  |     |  N  |  ,   |  ;   |   :   | = |
//             | SIFT| BSPC| SPC |     | ENT | COM  | mo2  |
                        display-name = "Base";
                        bindings = <
   &kp Q  &kp W &kp E      &kp R    &kp T           &kp Y   &kp U    &kp I     &kp O     &kp P
   &kp A  &kp S &kp D      &kp F    &kp G           &kp H   &kp J    &kp K     &kp L     &kp SEMI 
   &kp Z  &kp X &kp C      &kp V    &kp B           &kp N   &kp M    &kp COMMA &kp DOT   &kp (FSLH)
                &kp LSHIFT &kp BSPC &kp SPACE       &lt 3 RET &kp LGUI &mo 2
                        >;
                };

                lower_layer {
// ---------------------------------------------------------------------
// |   |    |    |     |     |      |  /  |  7  |  8  |  9  |  %  
// |   |    |    |     |     |      |  °  |  4  |  5  |  6  |  -  
// |   |    |    |     |     |      |  ,  |  1  |  2  |  3  |  +  
//               |     |     |      |  0  |  .  |  ,  |
                        display-name = "Numbers";
                        bindings = <
   &none   &none   &none    &none   &none      &kp LS(DOT)   &kp AMPS  &kp LS(N8)  &kp LPAR    &kp LS(APOS) 
   &none   &none   &none    &none   &none      &kp LS(MINUS) &kp DLLR  &kp PRCNT   &kp CARET   &kp EQUAL
   &none   &none   &none    &none   &none      &kp M         &kp EXCL  &kp AT      &kp HASH    &kp LS(FSLH)
                   &none    &none   &none      &kp RPAR  &kp LS(COMMA)    &kp M 
                        >;
                };

                raise_layer {
// --------------------------------------------------------------------
// |  @ |  é |  {  |  }  |  ` |     |  ~ |   è |  ! |  ç  |   à  |
// |  # |  & |  (  |  )  |  " |     |  \ |  -  |  _ |  |  |   €  |
// |  < |  > |  [  |  ]  |  ' |     |    |     |    |     |   $  |
//           |  ¨  |  ^  |  * |     |    |     |    |
                        display-name = "@#&<>";
                        bindings = <

   &kp RA(BSLH)      &kp N2         &kp RA(N5)      &kp RA(MINUS)      &kp BSLH       &kp RA(N)        &kp N7        &kp N8         &kp N9        &kp N0
   &kp RA(LS(BSLH))  &kp N1         &kp N5          &kp MINUS          &kp N3         &kp LS(RA(DOT))  &kp EQUAL     &kp LS(EQUAL)  &kp RA(LS(L)) &kp RA(RBKT)
   &kp GRAVE         &kp LS(GRAVE)  &kp RA(LS(N5))  &kp RA(LS(MINUS))  &kp N4         &none            &none         &none          &none         &kp RBKT
                                    &kp LS(LBKT)    &kp LBKT           &kp RBRC       &none            &none         &none
                        >;
                }; 

                motion {
// --------------------------------------------------------------------
// | 🔊  |  ⏪️ |  ⏯️  |  ⏩️ |     |     |  -  |  %  |     |      |
// | 🔈  |  ☀  |  👾  |  🔒 |     | LFT | DWN |  UP | RGT |  $   |
// | 🔇  |  🌑 |      |     |     |     |     |     |     |      |
//             |      |     |     |     |     |     |     |
                        display-name = "Media & Direction";
                        bindings = <

   &kp C_VOLUME_UP     &kp C_PREVIOUS   &kp C_PLAY_PAUSE    &kp C_NEXT    &none       &kp EQUAL &kp LS(APOS)  &none   &none      &none
   &kp C_VOLUME_DOWN   &kp C_BRI_UP     &none               &kp C_POWER   &none       &kp LEFT  &kp DOWN      &kp UP  &kp RIGHT  &kp RBKT
   &kp C_MUTE          &kp C_BRI_DN     &kp C_BRI_DN        &none         &none       &none     &none         &none   &none      &none
                       &none            &none               &none         &none       &none     &none
                        >;
                }; 

                linux_default_layer {
// ---------------------------------------------------------------------
// |  A  |  Z  |  E  |  R  |  T  |     |  Y  |  U   |  I   |   O   | P |
// |  Q  |  S  |  D  |  F  |  G  |     |  H  |  J   |  K   |   L   | M | 
// |  W  |  X  |  C  |  V  |  B  |     |  N  |  ,   |  ;   |   :   | = |
//             | SIFT| BSPC| SPC |     | ENT | COM  | mo6  |
                        display-name = "L_Base";
                        bindings = <
   &kp Q  &kp W &kp E      &kp R    &kp T           &kp Y     &kp U     &kp I     &kp O     &kp P
   &kp A  &kp S &kp D      &kp F    &kp G           &kp H     &kp J     &kp K     &kp L     &kp SEMI 
   &kp Z  &kp X &kp C      &kp V    &kp B           &kp N     &kp M     &kp COMMA &kp DOT   &kp EQUAL
                &kp LSHIFT &kp BSPC &kp SPACE       &lt 7 RET &kp LCTRL &mo 6
                        >;
                };

                linux_lower_layer { 
// ---------------------------------------------------------------------
// |   |    |    |     |     |      |  /  |  7  |  8  |  9  |  %  
// |   |    |    |     |     |      |  °  |  4  |  5  |  6  |  -  
// |   |    |    |     |     |      |  ,  |  1  |  2  |  3  |  +  
//               |     |     |      |  0  |  .  |  ,  |
                        display-name = "L_Numbers";
                        bindings = < 
   &none   &none   &none    &none   &none      &kp LS(DOT)   &kp AMPS       &kp LS(N8)  &kp LPAR    &kp LS(APOS) 
   &none   &none   &none    &none   &none      &kp LS(MINUS) &kp DLLR       &kp PRCNT   &kp CARET   &kp N6
   &none   &none   &none    &none   &none      &kp M         &kp EXCL       &kp AT      &kp HASH    &kp PLUS
                   &none    &none   &none      &kp RPAR      &kp LS(COMMA)  &kp M 
                        >;
                };

                linux_raise_layer {
// --------------------------------------------------------------------
// |  @ |  é |  {  |  }  |  ` |     |  ~ |   è |  ! |  ç  |   à  |
// |  # |  & |  (  |  )  |  " |     |  \ |  -  |  _ |  |  |   €  |
// |  < |  > |  [  |  ]  |  ' |     |    |     |    |     |   $  |
//           |  ¨  |  ^  |  * |     |    |     |    |
                        display-name = "L_@#&<>";
                        bindings = <
   &kp RA(N0)       &kp N2              &kp RA(N4)      &kp LS(EQUAL)   &kp RA(N7)      &kp RA(N2)    &kp N7        &kp LS(QMARK)  &kp N9          &kp N0
   &kp RA(N3)       &kp N1              &kp N5          &kp MINUS       &kp N3          &kp RA(N8)    &kp N6        &kp N8         &kp RA(N6) &kp RA(E)
   &kp LESS_THAN    &kp GREATER_THAN    &kp RA(N5)      &kp LS(MINUS)   &kp N4          &none         &none         &none          &none           &kp RBKT
                                    &kp LS(LBKT)    &kp LBKT            &kp RA(BSLH)    &none         &none         &none
                        >;
                }; 
            
                linux_motion {
// --------------------------------------------------------------------
// | 🔊  |  ⏪️ |  ⏯️ |  ⏩️ |     |     |  -  |  %  |     |      |
// | 🔈  |  ☀  |  👾 |  🔒 |     | LFT | DWN |  UP | RGT |  $   |
// | 🔇  |  🌑 |     |     |     |     |     |     |     |      |
//             |     |     |     |     |     |     |     |
                        display-name = "L_Media & Direction";
                        bindings = <
   &kp C_VOLUME_UP     &kp C_PREVIOUS   &kp C_PLAY_PAUSE    &kp C_NEXT    &none       &none     &kp N6        &kp LS(N5)  &none      &none
   &kp C_VOLUME_DOWN   &kp C_BRI_UP     &none               &kp C_POWER   &none       &kp LEFT  &kp DOWN      &kp UP     &kp RIGHT  &kp RBKT
   &kp C_MUTE          &kp C_BRI_DN     &kp C_BRI_DN        &none         &none       &none     &none         &none      &none      &none
                       &none            &none               &none         &none       &none     &none
                        >;
                }; 
         };
 };
